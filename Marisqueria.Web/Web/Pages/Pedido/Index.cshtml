@page
@model Web.Pages.Pedido.IndexModel

@{
    ViewData["Title"] = "Mis Pedidos";
}

<h1 class="text-center">Mis Pedidos</h1>

<div class="form-wrap" style="max-width: 1200px;">

    <div class="mb-3">

        <a asp-page="./Agregar"
           class="btn btn-success">
            Crear Pedido
        </a>

    </div>

    @if (Model.pedidos.Any())
    {
        <div class="table-responsive">

            <table class="table table-striped table-bordered align-middle">

                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Total</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var pedido in Model.pedidos)
                    {
                        <tr>

                            <td>
                                @pedido.FechaPedido.ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td>
                                ₡@pedido.Total.ToString("N2")
                            </td>

                            <td>
                                @pedido.Estado
                            </td>

                            <td>

                                <a asp-page="./Detalle"
                                   asp-route-id="@pedido.IdPedido"
                                   class="btn btn-primary btn-sm">
                                    Ver detalle
                                </a>

                                @if (pedido.Estado == "Pendiente")
                                {
                                    <a asp-page="./Editar"
                                       asp-route-id="@pedido.IdPedido"
                                       class="btn btn-warning btn-sm">
                                        Editar
                                    </a>

                                    <a asp-page="./Eliminar"
                                       asp-route-id="@pedido.IdPedido"
                                       class="btn btn-danger btn-sm">
                                        Eliminar
                                    </a>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }
    else
    {
        <div class="alert alert-info">
            No tienes pedidos registrados.
        </div>
    }

</div>