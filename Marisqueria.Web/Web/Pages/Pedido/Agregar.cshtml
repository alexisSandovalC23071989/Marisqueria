@page
@using System.Text.Json
@model Web.Pages.Pedido.AgregarModel

@{
    ViewData["Title"] = "Crear Pedido";
}

<h1 class="text-center">Crear Pedido</h1>

<div class="form-wrap" style="max-width: 1200px;">

    <form method="POST">

        <input type="hidden" asp-for="IdPedido" />

        <div class="form-group">
            <label class="control-label">
                Usuario
            </label>

        <input class="form-control"
            value="@User.Identity?.Name"
            readonly />

        <input type="hidden"
            asp-for="pedido.IdUsuario" />

        </div>

        <hr />

        <h4>Agregar Producto</h4>

        <div class="form-group">
            <label>Categoría</label>

            <select asp-for="IdCategoria"
                    asp-items="Model.categorias"
                    class="form-select"
                    id="categoriaSelect">

                <option value="">
                    Seleccione una categoría
                </option>

            </select>
        </div>

        <div class="form-group">
            <label>Producto</label>

            <select asp-for="IdProducto"
                    class="form-select"
                    id="productoSelect">

                <option value="">
                    Seleccione un producto
                </option>

            </select>
        </div>

        <div class="mt-2">
            <strong>Stock disponible:</strong>
            <span id="stockDisponible">0</span>
        </div>

        <div class="form-group">
            <label>Cantidad</label>

            <input asp-for="Cantidad"
                   type="number"
                   min="1"
                   class="form-control"
                   id="cantidadInput" />
        </div>

        <div id="mensajeStock"
             class="text-danger mt-1">
        </div>

        <div class="mt-3">

            <strong>Precio Unitario:</strong>
            ₡<span id="precioUnitario">0.00</span>

            <br />

            <strong>Subtotal:</strong>
            ₡<span id="subtotal">0.00</span>

        </div>

        <div class="text-danger"
             asp-validation-summary="All">
        </div>

        <div class="mt-3">

            <button type="submit"
                    class="btn btn-success"
                    id="btnAgregarProducto">
                Agregar Producto
            </button>

        </div>

    </form>


    @if (Model.detalles.Any())
    {
        <hr />

        <h4>Productos del Pedido</h4>

        <div class="table-responsive pedido-tabla-wrap">

            <table class="table table-striped table-bordered align-middle pedido-tabla">

                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Precio Original</th>
                        <th>Promoción</th>
                        <th>Precio Aplicado</th>
                        <th>Cantidad</th>
                        <th>Subtotal</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var detalle in Model.detalles)
                    {
                        <tr>

                            <td>
                                @detalle.NombreProducto
                            </td>

                            <td>
                                ₡@detalle.PrecioOriginal.ToString("N2")
                            </td>

                            <td>

                                @if (!string.IsNullOrEmpty(detalle.NombrePromocion))
                                {
                                    <strong>
                                        @detalle.NombrePromocion
                                    </strong>

                                    <br />

                                    @if (detalle.TipoDescuento == "PORCENTAJE")
                                    {
                                        <span class="text-success">
                                            @detalle.ValorDescuento.ToString("N2")% descuento
                                        </span>
                                    }
                                    else if (detalle.TipoDescuento == "MONTO")
                                    {
                                        <span class="text-success">
                                            ₡@detalle.ValorDescuento.ToString("N2") descuento
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span>Sin promoción</span>
                                }

                            </td>

                            <td>
                                ₡@detalle.PrecioUnitario.ToString("N2")
                            </td>

                            <td>
                                @detalle.Cantidad
                            </td>

                            <td>
                                ₡@detalle.Subtotal.ToString("N2")
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }


    @if (Model.pedidoActual != null)
    {
        <div class="text-end mt-3">

            <h3>
                Total:
                ₡@Model.pedidoActual.Total.ToString("N2")
            </h3>

            <p>
                Estado:
                <strong>
                    @Model.pedidoActual.Estado
                </strong>
            </p>

        </div>
    }


    <div class="actions mt-3">

        <a class="btn btn-primary"
           asp-page="./Index">
            Regresar
        </a>

        @if (Model.IdPedido.HasValue &&
             Model.detalles.Any())
        {
            <a class="btn btn-success"
               asp-page="./Index">
                Finalizar Pedido
            </a>
        }

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        const productos =
            @Html.Raw(JsonSerializer.Serialize(Model.productos));

        const stockProductos =
            @Html.Raw(JsonSerializer.Serialize(Model.stockProductos));


        const categoriaSelect =
            document.getElementById("categoriaSelect");

        const productoSelect =
            document.getElementById("productoSelect");

        const cantidadInput =
            document.getElementById("cantidadInput");

        const precioUnitario =
            document.getElementById("precioUnitario");

        const subtotal =
            document.getElementById("subtotal");

        const stockDisponible =
            document.getElementById("stockDisponible");

        const mensajeStock =
            document.getElementById("mensajeStock");

        const btnAgregarProducto =
            document.getElementById("btnAgregarProducto");


        let stockActual = 0;


        categoriaSelect.addEventListener(
            "change",
            function () {

                const idCategoria =
                    parseInt(this.value);

                productoSelect.innerHTML =
                    '<option value="">Seleccione un producto</option>';


                const productosFiltrados = productos.filter(p => p.IdCategoria === idCategoria);


                productosFiltrados.forEach(
                    producto => {

                        const option =
                            document.createElement("option");

                        option.value =
                            producto.IdProducto;

                        option.textContent =
                            producto.Nombre +
                            " - ₡" +
                            producto.PrecioVentaActual;

                        option.dataset.precio =
                            producto.PrecioVentaActual;

                        productoSelect.appendChild(option);
                    }
                );


                precioUnitario.textContent =
                    "0.00";

                subtotal.textContent =
                    "0.00";

                stockActual = 0;

                stockDisponible.textContent =
                    "0";

                mensajeStock.textContent =
                    "";

                btnAgregarProducto.disabled =
                    false;
            }
        );


        productoSelect.addEventListener(
            "change",
            function () {

                const idProducto =
                    parseInt(this.value);

                calcularSubtotal();


                if (!idProducto) {

                    stockActual = 0;

                    stockDisponible.textContent =
                        "0";

                    mensajeStock.textContent =
                        "";

                    btnAgregarProducto.disabled =
                        false;

                    return;
                }


                stockActual =
                    parseFloat(
                        stockProductos[idProducto] || 0
                    );


                stockDisponible.textContent =
                    stockActual;


                validarStock();
            }
        );


        cantidadInput.addEventListener(
            "input",
            function () {

                calcularSubtotal();

                validarStock();
            }
        );


        function calcularSubtotal() {

            const option =
                productoSelect.options[
                    productoSelect.selectedIndex
                ];


            const precio =
                parseFloat(
                    option?.dataset?.precio || 0
                );


            const cantidad =
                parseInt(
                    cantidadInput.value || 0
                );


            precioUnitario.textContent =
                precio.toFixed(2);


            subtotal.textContent =
                (precio * cantidad).toFixed(2);
        }


        function validarStock() {

            const cantidad =
                parseInt(
                    cantidadInput.value || 0
                );


            if (!productoSelect.value) {

                mensajeStock.textContent =
                    "";

                btnAgregarProducto.disabled =
                    false;

                return;
            }


            if (stockActual <= 0) {

                mensajeStock.textContent =
                    "Producto sin stock disponible.";

                btnAgregarProducto.disabled =
                    true;

                return;
            }


            if (cantidad > stockActual) {

                mensajeStock.textContent = `Solo hay ${stockActual} unidades disponibles.`;

                btnAgregarProducto.disabled = true;

                return;
            }


            mensajeStock.textContent =
                "";

            btnAgregarProducto.disabled =
                false;
        }

    </script>
}