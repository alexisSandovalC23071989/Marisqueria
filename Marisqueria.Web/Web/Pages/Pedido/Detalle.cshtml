@page
@model Web.Pages.Pedido.DetalleModel

@{
    ViewData["Title"] = "Detalle del Pedido";
}

<h1 class="text-center mb-4">
    Detalle del Pedido
</h1>

<div class="form-wrap"
     style="max-width: 1200px; margin: 0 auto;">

    <div class="mb-3">
        <strong>Fecha:</strong>
        <span class="ms-2">
            @Model.pedido.FechaPedido.ToString("dd/MM/yyyy HH:mm")
        </span>
    </div>

    <div class="mb-3">
       <strong>Usuario:</strong>
        @Model.NombreUsuario
    </div>

    <div class="mb-3">
        <strong>Estado:</strong>
        <span class="ms-2">
            @Model.pedido.Estado
        </span>
    </div>

    <hr class="my-4" />

    @if (Model.detalles.Any())
    {
        <div class="table-responsive pedido-tabla-wrap">

            <table class="table table-striped table-bordered align-middle pedido-tabla">

                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Cantidad</th>
                        <th>Precio Original</th>
                        <th>Descuento</th>
                        <th>Precio Aplicado</th>
                        <th>Subtotal</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var detalle in Model.detalles)
                    {
                        <tr>
                            <td>@detalle.NombreProducto</td>

                            <td>@detalle.Cantidad</td>

                            <td>
                                ₡@detalle.PrecioOriginal.ToString("N2")
                            </td>

                            <td>
                                @if (!string.IsNullOrEmpty(detalle.NombrePromocion))
                                {
                                    <strong>@detalle.NombrePromocion</strong>

                                    <br />

                                    @if (detalle.TipoDescuento == "PORCENTAJE")
                                    {
                                        <span class="text-success">
                                            @detalle.ValorDescuento.ToString("N2")% descuento
                                        </span>
                                    }
                                    else if (detalle.TipoDescuento == "MONTO")
                                    {
                                        <span class="text-success">
                                            ₡@detalle.ValorDescuento.ToString("N2") descuento
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span>Sin promoción</span>
                                }
                            </td>

                            <td>
                                ₡@detalle.PrecioUnitario.ToString("N2")
                            </td>

                            <td>
                                ₡@detalle.Subtotal.ToString("N2")
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>
    }
    else
    {
        <div class="alert alert-info">
            Este pedido no tiene productos.
        </div>
    }

    <hr class="my-4" />

    <div class="d-flex justify-content-end">
        <h3 class="mb-0">
            Total:
            ₡@Model.pedido.Total.ToString("N2")
        </h3>
    </div>

    <hr class="my-4" />

    <div class="actions">

        <a asp-page="./Index"
           class="btn btn-primary">
            ← Regresar
        </a>

    </div>

</div>