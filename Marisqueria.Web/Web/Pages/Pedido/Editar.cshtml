@page
@using System.Text.Json
@model Web.Pages.Pedido.EditarModel

@{
    ViewData["Title"] = "Editar Pedido";
}

<h1 class="text-center">Editar Pedido</h1>

<input type="hidden" asp-for="IdPedido" />

<div class="form-wrap">

    <h4>Productos del Pedido</h4>

    @if (Model.detalles.Any())
    {
        <table class="table table-striped table-bordered">

            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Precio Unitario</th>
                    <th>Cantidad</th>
                    <th>Subtotal</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var detalle in Model.detalles)
                {
                    <tr>
                        <td>
                            @detalle.NombreProducto
                        </td>

                        <td>
                            ₡@detalle.PrecioUnitario.ToString("N2")
                        </td>

                        <td>
                            <form method="post"
                                  asp-page-handler="Actualizar">

                                <input type="hidden"
                                       name="IdPedido"
                                       value="@Model.pedido.IdPedido" />

                                <input type="hidden"
                                       name="idDetalle"
                                       value="@detalle.IdDetalle" />

                                <input type="number"
                                       name="cantidad"
                                       value="@detalle.Cantidad"
                                       min="1"
                                       class="form-control"
                                       style="width:100px;" />

                                <button type="submit"
                                        class="btn btn-warning btn-sm mt-1">
                                    Actualizar
                                </button>

                            </form>
                        </td>

                        <td>
                            ₡@detalle.Subtotal.ToString("N2")
                        </td>

                        <td>
                            <form method="post"
                                  asp-page-handler="EliminarProducto">

                                <input type="hidden"
                                       name="idDetalle"
                                       value="@detalle.IdDetalle" />

                                <button type="submit"
                                        class="btn btn-danger btn-sm">
                                    Quitar
                                </button>

                            </form>
                        </td>
                    </tr>
                }

            </tbody>

        </table>

        <hr />

        <h4>Agregar otro producto</h4>

        <div class="text-danger"
     asp-validation-summary="All">
</div>

        <form method="post"
              asp-page-handler="AgregarProducto">

            <input type="hidden"
                   asp-for="IdPedido" />

            <div class="form-group">
                <label>Categoría</label>

                <select asp-for="IdCategoria"
                        asp-items="Model.categorias"
                        id="categoriaSelect"
                        class="form-select">

                    <option value="">
                        Seleccione una categoría
                    </option>

                </select>
            </div>

            <div class="form-group">
                <label>Producto</label>

                <select asp-for="IdProducto"
                        id="productoSelect"
                        class="form-select">

                    <option value="">
                        Seleccione un producto
                    </option>

                </select>
            </div>

            <div class="mt-2">
                <strong>Stock disponible:</strong>
                <span id="stockDisponible">0</span>
            </div>

            <div class="form-group">
                <label>Cantidad</label>

                <input asp-for="CantidadNueva"
                       type="number"
                       min="1"
                       id="cantidadNueva"
                       class="form-control" />
            </div>

            <div id="mensajeStock"
                 class="text-danger mt-1">
            </div>

            <div class="mt-3">

                <strong>Precio Unitario:</strong>
                ₡<span id="precioNuevo">0.00</span>

                <br />

                <strong>Subtotal:</strong>
                ₡<span id="subtotalNuevo">0.00</span>

            </div>

            <button type="submit"
                    class="btn btn-success mt-3"
                    id="btnAgregarProducto">
                Agregar Producto
            </button>

        </form>
    }

    <div class="text-end">
        <h3>
            Total:
            ₡@Model.pedido.Total.ToString("N2")
        </h3>
    </div>

    <div class="actions">

        <a asp-page="./Index"
           class="btn btn-primary">
            Regresar
        </a>

    </div>

</div>

@section Scripts {

    <script>

        const productos = @Html.Raw(JsonSerializer.Serialize(Model.productos));

        const stockProductos = @Html.Raw(JsonSerializer.Serialize(Model.stockProductos));

        const categoriaSelect = document.getElementById("categoriaSelect");

        const productoSelect = document.getElementById("productoSelect");

        const cantidadNueva = document.getElementById("cantidadNueva");

        const precioNuevo = document.getElementById("precioNuevo");

        const subtotalNuevo = document.getElementById("subtotalNuevo");

        const stockDisponible = document.getElementById("stockDisponible");

        const mensajeStock = document.getElementById("mensajeStock");

        const btnAgregarProducto = document.getElementById("btnAgregarProducto");

        let stockActual = 0;


        categoriaSelect.addEventListener("change", function() 
        {
                const idCategoria = parseInt(this.value);

                productoSelect.innerHTML = '<option value="">Seleccione un producto</option>';

                const filtrados = productos.filter( p => p.IdCategoria === idCategoria);

                filtrados.forEach(producto => 
                { 
                    const option = document.createElement("option");

                    option.value = producto.IdProducto;

                    option.textContent = producto.Nombre + " - ₡" + producto.PrecioVentaActual;

                    option.dataset.precio = producto.PrecioVentaActual;

                    productoSelect.appendChild(option);
                });

                precioNuevo.textContent = "0.00";
                subtotalNuevo.textContent = "0.00";
                stockActual = 0;
                stockDisponible.textContent = "0";
                mensajeStock.textContent = "";
                btnAgregarProducto.disabled = false;
            });


        productoSelect.addEventListener("change",function () 
        {
              const idProducto = parseInt(this.value);

                calcularNuevoSubtotal();

                if (!idProducto) {

                    stockActual = 0;

                    stockDisponible.textContent = "0";

                    mensajeStock.textContent = "";

                    btnAgregarProducto.disabled = false;

                    return;
                }

                stockActual = parseFloat( stockProductos[idProducto] || 0);

                stockDisponible.textContent = stockActual;

                validarStock();
            }
        );


        cantidadNueva.addEventListener("input",function () 
        {

                calcularNuevoSubtotal();

                validarStock();
            }
        );


        function calcularNuevoSubtotal() {

            const option = productoSelect.options[productoSelect.selectedIndex];

            const precio = parseFloat(option?.dataset?.precio || 0);

            const cantidad = parseInt(cantidadNueva.value || 0);

            precioNuevo.textContent = precio.toFixed(2);

            subtotalNuevo.textContent = (precio * cantidad).toFixed(2);
        }

        function validarStock() {

            const cantidad = parseInt(cantidadNueva.value || 0);

            if (!productoSelect.value) {

                mensajeStock.textContent = "";

                btnAgregarProducto.disabled = false;

                return;
            }

            if (stockActual <= 0) {

                mensajeStock.textContent =  "Producto sin stock disponible.";

                btnAgregarProducto.disabled = true;

                return;
            }

            if (cantidad > stockActual) {

                mensajeStock.textContent = `Solo hay ${stockActual} unidades disponibles.`;

                btnAgregarProducto.disabled = true;

                return;
            }

            mensajeStock.textContent = "";

            btnAgregarProducto.disabled = false;
        }

    </script>
}