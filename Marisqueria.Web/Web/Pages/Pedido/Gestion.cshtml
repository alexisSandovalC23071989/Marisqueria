@page
@model Web.Pages.Pedido.GestionModel

@{
    ViewData["Title"] = "Gestión de Pedidos";
}

<h1 class="text-center">Gestión de Pedidos</h1>

<div class="form-wrap" style="max-width: 1200px;">

    @if (Model.pedidos.Any())
    {
        <div class="table-responsive">

            <table class="table table-striped table-bordered align-middle">

                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Usuario</th>
                        <th>Total</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var pedido in Model.pedidos)
                    {
                        <tr>

                            <td>
                                @pedido.FechaPedido.ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td>
                                @pedido.NombreUsuario
                            </td>

                            <td>
                                ₡@pedido.Total.ToString("N2")
                            </td>

                            <td>
                                <strong>@pedido.Estado</strong>
                            </td>

                            <td>

                                @if (pedido.Estado == "Pendiente")
                                {
                                    <form method="post"
                                          asp-page-handler="Confirmar"
                                          class="d-inline">

                                        <input type="hidden"
                                               name="idPedido"
                                               value="@pedido.IdPedido" />

                                        <button type="submit"
                                                class="btn btn-success btn-sm">
                                            Confirmar Pedido
                                        </button>
                                    </form>

                                    <form method="post"
                                          asp-page-handler="Cancelar"
                                          class="d-inline">

                                        <input type="hidden"
                                               name="idPedido"
                                               value="@pedido.IdPedido" />

                                        <button type="submit"
                                                class="btn btn-danger btn-sm">
                                            Cancelar Pedido
                                        </button>
                                    </form>
                                }

                                else if (pedido.Estado == "Pendiente de Retiro")
                                {
                                    <form method="post"
                                          asp-page-handler="Preparar"
                                          class="d-inline">

                                        <input type="hidden"
                                               name="idPedido"
                                               value="@pedido.IdPedido" />

                                        <button type="submit"
                                                class="btn btn-warning btn-sm">
                                            Marcar Preparado
                                        </button>
                                    </form>

                                    <form method="post"
                                          asp-page-handler="Cancelar"
                                          class="d-inline">

                                        <input type="hidden"
                                               name="idPedido"
                                               value="@pedido.IdPedido" />

                                        <button type="submit"
                                                class="btn btn-danger btn-sm">
                                            Cancelar Pedido
                                        </button>
                                    </form>
                                }

                                else if (pedido.Estado == "Preparado")
                                {
                                    <form method="post"
                                          asp-page-handler="Entregar"
                                          class="d-inline">

                                        <input type="hidden"
                                               name="idPedido"
                                               value="@pedido.IdPedido" />

                                        <button type="submit"
                                                class="btn btn-primary btn-sm">
                                            Entregar Pedido
                                        </button>
                                    </form>
                                }

                                else if (pedido.Estado == "Entregado")
                                {
                                    <span class="badge bg-success">
                                        Entregado
                                    </span>
                                }

                                else if (pedido.Estado == "Cancelado")
                                {
                                    <span class="badge bg-danger">
                                        Cancelado
                                    </span>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }
    else
    {
        <div class="alert alert-info">
            No hay pedidos registrados.
        </div>
    }

    <div class="actions mt-3">

        <a asp-page="./Index"
           class="btn btn-primary">
            Regresar
        </a>

    </div>

</div>