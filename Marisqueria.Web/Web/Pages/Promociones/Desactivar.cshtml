@page "{id:int}"
@model Web.Pages.Promociones.DesactivarModel
@{ ViewData["Title"] = "Desactivar promoción"; }
<div class="form-wrap"><h1>Desactivar promoción</h1><p>¿Confirma que desea desactivar <strong>@Model.Promocion.Nombre</strong>? Dejará de mostrarse y aplicarse, pero permanecerá en el historial.</p><form method="post"><div class="actions"><a class="btn btn-primary" asp-page="./Index">Cancelar</a><button class="btn btn-danger" type="submit">Sí, desactivar</button></div></form></div>
