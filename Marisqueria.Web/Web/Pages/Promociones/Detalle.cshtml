@page "{id:int}"
@model Web.Pages.Promociones.DetalleModel
@{ ViewData["Title"] = "Detalle de promoción"; }
<div class="page-heading"><div><h1>@Model.Promocion.Nombre</h1><p>@Model.Promocion.Descripcion</p></div><span class="badge badge-@Model.Promocion.Estado.ToLower()">@Model.Promocion.Estado</span></div>
<div class="card"><div class="card-body">
    <div class="discount">@(Model.Promocion.TipoDescuento == "PORCENTAJE" ? $"{Model.Promocion.ValorDescuento:0.##}%" : Model.Promocion.ValorDescuento.ToString("C"))</div>
    <p>Vigencia: @Model.Promocion.FechaInicio.ToString("dd/MM/yyyy HH:mm") – @Model.Promocion.FechaFin.ToString("dd/MM/yyyy HH:mm")</p>
    @if (Model.Promocion.Categorias.Any())
    {
        <div class="promo-categories">
            <strong>Categorías completas:</strong>
            @foreach (var categoria in Model.Promocion.Categorias)
            {
                <span class="badge badge-activa">@categoria.Nombre</span>
            }
        </div>
    }
    <div class="table-wrap"><table><thead><tr><th>Producto</th><th>Precio original</th><th>Precio promocional</th><th>Ahorro</th></tr></thead><tbody>
    @foreach (var producto in Model.Promocion.Productos) { <tr><td>@producto.Nombre</td><td>@producto.PrecioOriginal.ToString("C")</td><td><strong>@producto.PrecioPromocional.ToString("C")</strong></td><td>@((producto.PrecioOriginal-producto.PrecioPromocional).ToString("C"))</td></tr> }
    </tbody></table></div>
    <div class="actions"><a class="btn btn-primary" asp-page="./Index">Regresar</a></div>
</div></div>
