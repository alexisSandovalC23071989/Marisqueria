@page
@model Web.Pages.Categorias.DetalleModel
@{
    ViewData["Title"] = "Detalle de categoría";
}

<h1 class="text-center">Detalle de categoría</h1>
<div class="form-wrap">
    <dl class="detail-list">
        <dt>Id</dt><dd>@Model.Categoria.IdCategoria</dd>
        <dt>Nombre</dt><dd>@Model.Categoria.Nombre</dd>
    </dl>
    <div class="actions">
        <a class="btn btn-primary" asp-page="./Index">Regresar</a>
        @if (User.IsInRole("Administrador"))
        {
            <a class="btn btn-warning" asp-page="./Editar" asp-route-id="@Model.Categoria.IdCategoria">Editar</a>
        }
    </div>
</div>
