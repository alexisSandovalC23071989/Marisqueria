@{
    string paginaActual = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;

    string Activo(string seccion) =>
        paginaActual.StartsWith(
            seccion,
            StringComparison.OrdinalIgnoreCase)
            ? "active"
            : string.Empty;

    bool catalogoActivo =
        paginaActual.StartsWith("/Productos", StringComparison.OrdinalIgnoreCase) ||
        paginaActual.StartsWith("/Categorias", StringComparison.OrdinalIgnoreCase) ||
        paginaActual.StartsWith("/Inventarios", StringComparison.OrdinalIgnoreCase) ||
        paginaActual.StartsWith("/Proveedores", StringComparison.OrdinalIgnoreCase) ||
        paginaActual.StartsWith("/Promociones", StringComparison.OrdinalIgnoreCase);

    bool esInicioSinSesion =
        paginaActual.Equals("/Index", StringComparison.OrdinalIgnoreCase) &&
        User.Identity?.IsAuthenticated != true;
}

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Costa de Pájaros
    </title>

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    @await RenderSectionAsync(
        "Styles",
        required: false)

</head>

<body>

    <header class="site-header">

        <div class="market-strip">

            <div class="container market-strip__inner">

                <span>
                    Desde Costa de Pájaros
                </span>

                <span>
                    Control de calidad y cadena de frío
                </span>

            </div>

        </div>

        <nav class="navbar">

            <div class="container nav-container">

                <!-- LOGO -->

                <a class="navbar-brand"
                   asp-area=""
                   asp-page="/Index"
                   aria-label="Ir al inicio">

                    <img class="brand-logo"
                         src="~/images/logo-costa-pajaros.png"
                         alt="Logo de Distribuidora de Mariscos De Costa de Pájaros" />

                    <span class="brand-copy">

                        <strong>
                            Distribuidora de Mariscos
                        </strong>

                        <small>
                            De Costa de Pájaros
                        </small>

                    </span>

                </a>

                <!-- MENU PRINCIPAL -->

                <div class="navbar-nav">


                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a class="nav-link @Activo("/Index")"
                           asp-area=""
                           asp-page="/Index">
                            Inicio
                        </a>
                        <details class="nav-dropdown">
                            <summary class="nav-link @(catalogoActivo ? "active" : string.Empty)">
                                Catálogo
                                <i class="bi bi-chevron-down" aria-hidden="true"></i>
                            </summary>
                            <div class="nav-dropdown__menu">
                                <a class="nav-dropdown__item @Activo("/Productos")" asp-page="/Productos/Index">
                                    <i class="bi bi-basket" aria-hidden="true"></i>
                                    Productos
                                </a>
                                <a class="nav-dropdown__item @Activo("/Categorias")" asp-page="/Categorias/Index">
                                    <i class="bi bi-tags" aria-hidden="true"></i>
                                    Categorías
                                </a>
                                <a class="nav-dropdown__item @Activo("/Inventarios")" asp-page="/Inventarios/Index">
                                    <i class="bi bi-box-seam" aria-hidden="true"></i>
                                    Inventario
                                </a>
                                <a class="nav-dropdown__item @Activo("/Proveedores")" asp-page="/Proveedores/Index">
                                    <i class="bi bi-truck" aria-hidden="true"></i>
                                    Proveedores
                                </a>
                                <a class="nav-dropdown__item @Activo("/Promociones")" asp-page="/Promociones/Index">
                                    <i class="bi bi-percent" aria-hidden="true"></i>
                                    Promociones
                                </a>
                            </div>
                        </details>

                        <a class="nav-link @Activo("/Pedido")"
                           asp-area=""
                           asp-page="/Pedido/Index">
                            Hacer Pedido
                        </a>
                    }
                    @if (User.IsInRole("Administrador"))
                    {
                    <a class="nav-link @Activo("/Autenticacion")"
                       asp-area=""
                       asp-page="/Autenticacion/Usuarios">
                        Usuarios
                    </a>
                    <a class="nav-link @Activo("/Pedido/Gestion")"
                       asp-area=""
                       asp-page="/Pedido/Gestion">
                        Gestionar Pedidos
                    </a>
                    }

                </div>

                <!-- USUARIO AUTENTICADO -->

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="usuario-menu">

                        <span class="nav-link">
                            Hola, @User.Identity.Name
                        </span>

                        <a class="nav-link"
                           asp-page="/Autenticacion/Logout">
                            Cerrar sesión
                        </a>

                    </div>
                }
                else
                {
                    <div class="usuario-menu">
                        <a class="nav-login-button"
                           asp-page="/Autenticacion/Login">
                            <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>
                            Iniciar sesión
                        </a>
                    </div>
                }

            </div>

        </nav>

    </header>

    <!-- CONTENIDO -->

    <div class="container page-shell @(esInicioSinSesion ? "page-shell--guest-home" : string.Empty)">

        <main role="main"
              class="pb-3">

            @RenderBody()

        </main>

    </div>

    <!-- FOOTER -->

    <footer class="footer">

        <div class="container footer__inner">

            <div class="footer-brand">

                <img src="~/images/logo-costa-pajaros.png"
                     alt="Logo de Distribuidora de Mariscos De Costa de Pájaros" />

                <div>

                    <strong>
                        Distribuidora de Mariscos
                    </strong>

                    <span>
                        De Costa de Pájaros
                    </span>

                </div>

            </div>

            <span>
                &copy; 2026
            </span>

        </div>

    </footer>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync(
        "Scripts",
        required: false)

</body>

</html>
