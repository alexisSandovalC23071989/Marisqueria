@page "{idProveedor:int}/{idProducto:int}"
@model Web.Pages.Proveedores.EditarProductoModel
@{
    ViewData["Title"] = "Editar Producto del Proveedor";
}

<h1 class="text-center">Editar Producto</h1>
<p class="text-center">Proveedor: <b>@Model.NombreProveedor</b> — Producto: <b>@Model.NombreProducto</b></p>

<div class="form-wrap">
    <form method="POST">
        <div class="form-group">
            <label class="control-label" asp-for="productoProveedor.PrecioCompra"></label>
            <input class="form-control" asp-for="productoProveedor.PrecioCompra" />
            <span class="text-danger" asp-validation-for="productoProveedor.PrecioCompra"></span>
        </div>
        <div class="form-group">
            <label class="control-label" asp-for="productoProveedor.UnidadMedida"></label>
            <input class="form-control" asp-for="productoProveedor.UnidadMedida" />
            <span class="text-danger" asp-validation-for="productoProveedor.UnidadMedida"></span>
        </div>
        <div class="text-danger" asp-validation-summary="All"></div>
        <div class="actions">
            <a type="button" class="btn btn-primary" asp-page="./Detalle" asp-route-id="@Model.IdProveedor">Regresar</a>
            <input type="submit" class="btn btn-success" value="Guardar" />
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
