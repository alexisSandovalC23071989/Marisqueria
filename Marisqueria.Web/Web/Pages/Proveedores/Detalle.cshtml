@page "{id:int}"
@model Web.Pages.Proveedores.DetalleModel
@{
    ViewData["Title"] = "Detalle Proveedor";
}

<h1>Detalle Proveedor</h1>

<div class="card">
    <div class="card-body">
        <h5 class="card-title">@Html.DisplayFor(modelo => modelo.proveedor.Empresa)</h5>
        <h6 class="card-subtitle">@Html.DisplayFor(modelo => modelo.proveedor.CedulaJuridica)</h6>
        <div><b>@Html.DisplayNameFor(modelo => modelo.proveedor.Contacto): </b>@Html.DisplayFor(modelo => modelo.proveedor.Contacto)</div>
        <div><b>@Html.DisplayNameFor(modelo => modelo.proveedor.Telefono): </b>@Html.DisplayFor(modelo => modelo.proveedor.Telefono)</div>
        <div><b>@Html.DisplayNameFor(modelo => modelo.proveedor.Correo): </b>@Html.DisplayFor(modelo => modelo.proveedor.Correo)</div>
        <div><b>@Html.DisplayNameFor(modelo => modelo.proveedor.Direccion): </b>@Html.DisplayFor(modelo => modelo.proveedor.Direccion)</div>
        <div>
            <b>@Html.DisplayNameFor(modelo => modelo.proveedor.Estado): </b>
            @if (Model.proveedor.Estado == "Activo")
            {
                <span class="badge bg-success">Activo</span>
            }
            else
            {
                <span class="badge bg-secondary">Inactivo</span>
            }
        </div>
    </div>
</div>
<br />
<div class="actions">
    <a type="button" class="btn btn-primary" asp-page="./Index">Regresar</a>
    @if (User.IsInRole("Administrador"))
    {
        <a class="btn btn-warning" asp-page="./Editar" asp-route-id="@Model.proveedor.IdProveedor">Editar</a>
    }
</div>

<hr />

<div class="d-flex justify-content-between align-items-center">
    <h3>Productos que suministra</h3>
    @if (User.IsInRole("Administrador"))
    {
        <a class="btn btn-success" asp-page="./AgregarProducto" asp-route-idProveedor="@Model.proveedor.IdProveedor">Agregar producto</a>
    }
</div>

@if (Model.productos.Count == 0)
{
    <p class="text-center mt-4">Este proveedor no tiene productos asociados.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Producto</th>
                <th>Precio de Compra</th>
                <th>Unidad de Medida</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var producto in Model.productos)
            {
                <tr>
                    <td>@producto.Producto</td>
                    <td>@producto.PrecioCompra.ToString("C")</td>
                    <td>@producto.UnidadMedida</td>
                    <td>
                        @if (User.IsInRole("Administrador"))
                        {
                            <div class="inline-actions">
                                <a class="btn btn-warning btn-sm action-btn" asp-page="./EditarProducto"
                                   asp-route-idProveedor="@Model.proveedor.IdProveedor"
                                   asp-route-idProducto="@producto.IdProducto">Editar</a>
                                <form method="post" asp-page-handler="EliminarProducto"
                                      asp-route-idProveedor="@Model.proveedor.IdProveedor"
                                      asp-route-idProducto="@producto.IdProducto"
                                      onsubmit="return confirm('¿Quitar @producto.Producto de este proveedor?');">
                                    <button type="submit" class="btn btn-danger btn-sm action-btn">Quitar</button>
                                </form>
                            </div>
                        }
                        else
                        {
                            <span class="text-muted">Solo lectura</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
