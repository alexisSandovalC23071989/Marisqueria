@page "{id:int}"
@model Web.Pages.Proveedores.EditarModel
@{
    ViewData["Title"] = "Editar Proveedor";
}

<h1 class="text-center">Editar Proveedor</h1>

<div class="form-wrap">
    <form method="POST">
        <div class="form-group">
            <label class="control-label" asp-for="proveedor.Empresa"></label>
            <input class="form-control" asp-for="proveedor.Empresa" />
            <span class="text-danger" asp-validation-for="proveedor.Empresa"></span>
        </div>
        <div class="form-group">
            <label class="control-label" asp-for="proveedor.CedulaJuridica"></label>
            <input class="form-control" asp-for="proveedor.CedulaJuridica" placeholder="3-101-123456" />
            <span class="text-danger" asp-validation-for="proveedor.CedulaJuridica"></span>
        </div>
        <div class="form-group">
            <label class="control-label" asp-for="proveedor.Contacto"></label>
            <input class="form-control" asp-for="proveedor.Contacto" />
            <span class="text-danger" asp-validation-for="proveedor.Contacto"></span>
        </div>
        <div class="form-group">
            <label class="control-label" asp-for="proveedor.Telefono"></label>
            <input class="form-control" asp-for="proveedor.Telefono" />
            <span class="text-danger" asp-validation-for="proveedor.Telefono"></span>
        </div>
        <div class="form-group">
            <label class="control-label" asp-for="proveedor.Correo"></label>
            <input class="form-control" asp-for="proveedor.Correo" />
            <span class="text-danger" asp-validation-for="proveedor.Correo"></span>
        </div>
        <div class="form-group">
            <label class="control-label" asp-for="proveedor.Direccion"></label>
            <textarea class="form-control" asp-for="proveedor.Direccion"></textarea>
            <span class="text-danger" asp-validation-for="proveedor.Direccion"></span>
        </div>
        <div class="form-group">
            <label for="estado">Estado</label>
            <select asp-for="proveedor.Estado" class="form-select" id="estado">
                <option value="Activo">Activo</option>
                <option value="Inactivo">Inactivo</option>
            </select>
            <span class="text-danger" asp-validation-for="proveedor.Estado"></span>
        </div>
        <div class="text-danger" asp-validation-summary="All"></div>
        <div class="actions">
            <a type="button" class="btn btn-primary" asp-page="./Index">Regresar</a>
            <input type="submit" class="btn btn-success" value="Guardar" />
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
