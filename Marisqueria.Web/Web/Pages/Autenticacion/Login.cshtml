@page
@model Web.Pages.Autenticacion.LoginModel
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Iniciar sesión</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/login.css"
          asp-append-version="true" />
</head>

<body>

    <div class="login-page">

        <a asp-page="/Index"
           class="btn-volver-inicio">
            <i class="bi bi-house-door" aria-hidden="true"></i>
            Volver al inicio
        </a>

        <div class="panel-logo">
            <img src="~/images/logo-mariscos.png"
                 alt="Mariscos de Costa de Pájaros"
                 class="logo-mariscos" />
        </div>

        <div class="panel-login">

            <div class="login-card">

                <div class="icono-usuario">
                    <i class="bi bi-person-circle"></i>
                </div>

                <h2>Inicia sesión</h2>

                @if (!string.IsNullOrWhiteSpace(Model.Error))
                {
                    <div class="mensaje-error">
                        @Model.Error
                    </div>
                }

                <form method="post">

                    <div class="campo">
                        <input asp-for="Login.Correo"
                               type="email"
                               placeholder="Correo" />

                        <span asp-validation-for="Login.Correo"
                              class="error-validacion">
                        </span>
                    </div>

                    <div class="campo">
                        <input asp-for="Login.Contrasena"
                               type="password"
                               placeholder="Contraseña" />

                        <span asp-validation-for="Login.Contrasena"
                              class="error-validacion">
                        </span>
                    </div>

                    <button type="submit"
                            class="btn-continuar">
                        Continuar
                    </button>

                </form>

                <a asp-page="/Autenticacion/OlvidePassword"
                   class="link-recuperar">
                    ¿Olvidaste tu correo o contraseña?
                </a>

                <div class="separador">
                    o
                </div>

                <a asp-page="/Autenticacion/Registro"
                   class="link-registro">
                    Regístrate
                </a>

            </div>

        </div>

    </div>

    <partial name="_ValidationScriptsPartial" />

</body>
</html>
