@page "{id:guid}"
@model Web.Pages.Autenticacion.EditarUsuarioModel
@{
    ViewData["Title"] = "Editar usuario";
}

<div class="page-heading">
    <div>
        <h1>Editar usuario</h1>
        <p>Modifica la información del usuario seleccionado.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="mensaje-error">
        @Model.Error
    </div>
}

<form method="post">

    <div class="form-group">
        <label asp-for="Usuario.Nombre">Nombre</label>

        <input asp-for="Usuario.Nombre"
               class="form-control" />

        <span asp-validation-for="Usuario.Nombre"
              class="text-danger">
        </span>
    </div>

    <div class="form-group">
        <label asp-for="Usuario.Correo">Correo</label>

        <input asp-for="Usuario.Correo"
               type="email"
               class="form-control" />

        <span asp-validation-for="Usuario.Correo"
              class="text-danger">
        </span>
    </div>

    <div class="form-group">
        <label asp-for="Usuario.Telefono">Teléfono</label>

        <input asp-for="Usuario.Telefono"
               class="form-control" />

        <span asp-validation-for="Usuario.Telefono"
              class="text-danger">
        </span>
    </div>

    <div class="form-group">
        <label asp-for="Usuario.IdRol">Rol</label>

        <select asp-for="Usuario.IdRol"
                class="form-select">

            <option value="">Seleccione un rol</option>

            <option value="B5E8CE71-1214-4367-A91C-ADA23F757435">
                Administrador
            </option>

            <option value="142EC776-1635-4029-BE5B-37BF4CC1DE12">
                Cliente
            </option>

        </select>

        <span asp-validation-for="Usuario.IdRol"
              class="text-danger">
        </span>
    </div>

    <div class="actions">

        <button type="submit"
                class="btn btn-success">
            Guardar cambios
        </button>

        <a asp-page="/Autenticacion/Usuarios"
           class="btn btn-danger">
            Cancelar
        </a>

    </div>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}