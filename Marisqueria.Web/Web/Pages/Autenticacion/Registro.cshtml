@page
@model Web.Pages.Autenticacion.RegistroModel
@{
    ViewData["Title"] = "Registro";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Registro</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/registro.css"
          asp-append-version="true" />
</head>

<body>

    <div class="registro-page">

        <a asp-page="/Index"
           class="btn-volver-inicio">
            <i class="bi bi-house-door" aria-hidden="true"></i>
            Volver al inicio
        </a>

        <div class="panel-logo">
            <img src="~/images/logo-mariscos.png"
                 alt="Mariscos de Costa de Pájaros"
                 class="logo-mariscos" />
        </div>

        <div class="panel-registro">

            <div class="registro-card">

                <div class="icono-usuario">
                    <i class="bi bi-person-circle"></i>
                </div>

                <h2>Regístrate</h2>

                @if (!string.IsNullOrWhiteSpace(Model.Error))
                {
                    <div class="mensaje-error">
                        @Model.Error
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Mensaje))
                {
                    <div class="mensaje-exito">
                        @Model.Mensaje
                    </div>
                }

                <form method="post">

                    <div class="campo">
                        <input asp-for="Registro.Nombre"
                               placeholder="Nombre" />

                        <span asp-validation-for="Registro.Nombre"
                              class="error-validacion">
                        </span>
                    </div>

                    <div class="campo">
                        <input asp-for="Registro.Correo"
                               type="email"
                               placeholder="Correo" />

                        <span asp-validation-for="Registro.Correo"
                              class="error-validacion">
                        </span>
                    </div>

                    <div class="campo">
                        <input asp-for="Registro.Telefono"
                               placeholder="Teléfono" />

                        <span asp-validation-for="Registro.Telefono"
                              class="error-validacion">
                        </span>
                    </div>

                    <div class="campo">
                        <input asp-for="Registro.Contrasena"
                               type="password"
                               placeholder="Contraseña" />

                        <span asp-validation-for="Registro.Contrasena"
                              class="error-validacion">
                        </span>
                    </div>

                    <div class="campo">
                        <input asp-for="Registro.ConfirmarContrasena"
                               type="password"
                               placeholder="Confirmar contraseña" />

                        <span asp-validation-for="Registro.ConfirmarContrasena"
                              class="error-validacion">
                        </span>
                    </div>

                    <button type="submit"
                            class="btn-registrar">
                        Registrarme
                    </button>

                </form>

                <div class="volver-login">
                    <span>¿Ya tienes una cuenta?</span>

                    <a asp-page="/Autenticacion/Login">
                        Inicia sesión
                    </a>
                </div>

            </div>

        </div>

    </div>

    <partial name="_ValidationScriptsPartial" />

</body>
</html>
