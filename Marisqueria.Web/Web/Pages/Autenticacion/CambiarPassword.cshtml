@page
@model Web.Pages.Autenticacion.CambiarPasswordModel
@{
    ViewData["Title"] = "Cambiar contraseña";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Cambiar contraseña</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/cambiar-password.css"
          asp-append-version="true" />
</head>

<body>

    <div class="cambiar-page">

        <div class="panel-logo">
            <img src="~/images/logo-mariscos.png"
                 alt="Mariscos de Costa de Pájaros"
                 class="logo-mariscos" />
        </div>

        <div class="panel-cambiar">

            <div class="cambiar-card">

                <div class="icono-usuario">
                    <i class="bi bi-shield-lock"></i>
                </div>

                <h2>Cambiar contraseña</h2>

                @if (!string.IsNullOrWhiteSpace(Model.Error))
                {
                    <div class="mensaje-error">
                        @Model.Error
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Mensaje))
                {
                    <div class="mensaje-exito">
                        @Model.Mensaje
                    </div>
                }

                <form method="post">

                    <input asp-for="Solicitud.Token"
                           type="hidden" />

                    <div class="campo">
                        <input asp-for="Solicitud.NuevaContrasena"
                               type="password"
                               placeholder="Nueva contraseña" />

                        <span asp-validation-for="Solicitud.NuevaContrasena"
                              class="error-validacion">
                        </span>
                    </div>

                    <div class="campo">
                        <input asp-for="Solicitud.ConfirmarContrasena"
                               type="password"
                               placeholder="Confirmar contraseña" />

                        <span asp-validation-for="Solicitud.ConfirmarContrasena"
                              class="error-validacion">
                        </span>
                    </div>

                    <button type="submit"
                            class="btn-cambiar">
                        Cambiar contraseña
                    </button>

                </form>

                <a asp-page="/Autenticacion/Login"
                   class="volver-login">
                    Volver al inicio de sesión
                </a>

            </div>

        </div>

    </div>

    <partial name="_ValidationScriptsPartial" />

</body>
</html>