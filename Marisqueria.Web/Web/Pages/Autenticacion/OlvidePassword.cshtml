@page
@model Web.Pages.Autenticacion.OlvidePasswordModel
@{
    ViewData["Title"] = "Recuperar contraseña";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Recuperar contraseña</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/olvide-password.css"
          asp-append-version="true" />
</head>

<body>

    <div class="recuperacion-page">

        <div class="panel-logo">
            <img src="~/images/logo-mariscos.png"
                 alt="Mariscos de Costa de Pájaros"
                 class="logo-mariscos" />
        </div>

        <div class="panel-recuperacion">

            <div class="recuperacion-card">

                <div class="icono-usuario">
                    <i class="bi bi-key"></i>
                </div>

                <h2>Recuperar contraseña</h2>

                <p class="texto-ayuda">
                    Ingresa tu correo y te enviaremos un enlace para cambiar tu contraseña.
                </p>

                @if (!string.IsNullOrWhiteSpace(Model.Error))
                {
                    <div class="mensaje-error">
                        @Model.Error
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Mensaje))
                {
                    <div class="mensaje-exito">
                        @Model.Mensaje
                    </div>
                }

                <form method="post">

                    <div class="campo">
                        <input asp-for="Solicitud.Correo"
                               type="email"
                               placeholder="Correo" />

                        <span asp-validation-for="Solicitud.Correo"
                              class="error-validacion">
                        </span>
                    </div>

                    <button type="submit"
                            class="btn-enviar">
                        Enviar enlace
                    </button>

                </form>

                <a asp-page="/Autenticacion/Login"
                   class="volver-login">
                    Volver al inicio de sesión
                </a>

            </div>

        </div>

    </div>

    <partial name="_ValidationScriptsPartial" />

</body>
</html>