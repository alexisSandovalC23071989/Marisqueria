@page
@model Web.Pages.Productos.AgregarModel
@{
    ViewData["Title"] = "Agregar Producto";
}

<div class="module-header">
    <div>
        <h1>Agregar producto</h1>
        <p>Registre un producto y asígnelo a su categoría.</p>
    </div>
</div>

<div class="form-wrap">
    <form method="post">
        <div class="form-group">
            <label for="categorias">Categoría</label>
            <select asp-for="producto.IdCategoria" class="form-select" asp-items="Model.categorias" id="categorias">
                <option value="">Seleccione una categoría</option>
            </select>
            <span class="text-danger" asp-validation-for="producto.IdCategoria"></span>
        </div>
        <div class="form-group">
            <label class="control-label" asp-for="producto.Nombre"></label>
            <input class="form-control" asp-for="producto.Nombre" />
            <span class="text-danger" asp-validation-for="producto.Nombre"></span>
        </div>
        <div class="form-group">
            <label class="control-label" asp-for="producto.Descripcion"></label>
            <textarea class="form-control" asp-for="producto.Descripcion"></textarea>
            <span class="text-danger" asp-validation-for="producto.Descripcion"></span>
        </div>
        <div class="form-group">
            <label class="control-label" asp-for="producto.PrecioVentaActual"></label>
            <input class="form-control" asp-for="producto.PrecioVentaActual" />
            <span class="text-danger" asp-validation-for="producto.PrecioVentaActual"></span>
        </div>
        <div class="form-group">
            <label class="control-label" asp-for="producto.Imagen"></label>
            <input class="form-control" asp-for="producto.Imagen" />
            <span class="text-danger" asp-validation-for="producto.Imagen"></span>
        </div>
        <div class="text-danger" asp-validation-summary="All"></div>
        <div class="actions">
            <a class="btn btn-secondary" asp-page="./Index">
                <i class="bi bi-arrow-left" aria-hidden="true"></i>
                Regresar
            </a>
            <button type="submit" class="btn btn-success">
                <i class="bi bi-plus-lg" aria-hidden="true"></i>
                Agregar producto
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
