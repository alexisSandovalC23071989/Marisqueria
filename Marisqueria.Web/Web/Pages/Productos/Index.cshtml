@page
@model Web.Pages.Productos.IndexModel
@{
    ViewData["Title"] = "Productos";
}

@section Styles {
    <link rel="stylesheet" href="~/css/productos.css" asp-append-version="true" />
}

<section class="products-page">
    <div class="products-heading">
        <div>
            <h1>Listado de Productos</h1>
            <p>Productos registrados para la marisquería.</p>
        </div>
        @if (User.IsInRole("Administrador"))
        {
            <a class="btn btn-primary" asp-page="./Agregar">
                <i class="bi bi-plus-lg" aria-hidden="true"></i>
                Agregar producto
            </a>
        }
    </div>

    @if (Model.productos.Any())
    {
        <div class="products-grid">
            @foreach (var producto in Model.productos)
            {
                <article class="product-card">
                    <div class="product-card__media">
                        <img class="product-card__image"
                             src="@producto.Imagen"
                             alt="@producto.Nombre"
                             loading="lazy"
                             onerror="this.onerror=null; this.src='/images/hero-pescaderia.png'; this.classList.add('product-card__image--fallback');" />
                    </div>
                    <div class="product-card__body">
                        <span class="product-card__category">@Html.DisplayFor(modelo => producto.Categoria)</span>
                        <h2 class="product-card__title">@Html.DisplayFor(modelo => producto.Nombre)</h2>
                        <p class="product-card__description">@Html.DisplayFor(modelo => producto.Descripcion)</p>
                        <span class="product-card__price">@producto.PrecioVentaActual.ToString("C")</span>
                        <div class="product-card__actions @(!User.IsInRole("Administrador") ? "product-card__actions--viewer" : string.Empty)">
                            <a class="btn btn-primary action-btn" asp-page="./Detalle" asp-route-id="@producto.IdProducto">
                                <i class="bi bi-eye" aria-hidden="true"></i>
                                Detalle
                            </a>
                            @if (User.IsInRole("Administrador"))
                            {
                                <a class="btn btn-warning action-btn" asp-page="./Editar" asp-route-id="@producto.IdProducto">
                                    <i class="bi bi-pencil-square" aria-hidden="true"></i>
                                    Editar
                                </a>
                                <a class="btn btn-danger action-btn" asp-page="./Eliminar" asp-route-id="@producto.IdProducto">
                                    <i class="bi bi-trash3" aria-hidden="true"></i>
                                    Eliminar
                                </a>
                            }
                        </div>
                    </div>
                </article>
            }
        </div>
    }
    else
    {
        <div class="products-empty-state">
            <h2>No hay productos registrados</h2>
            <p>Agregue el primer producto para verlo en este listado.</p>
        </div>
    }
</section>
