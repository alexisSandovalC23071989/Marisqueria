@page
@model Web.Pages.Productos.EditarModel
@{
    ViewData["Title"] = "Editar Producto";
}

<div class="module-header">
    <div>
        <h1>Editar producto</h1>
        <p>Actualice la información comercial del producto.</p>
    </div>
</div>

<div class="form-wrap">
    <form method="post">
        <div class="form-group">
            <label for="categorias">Categoría</label>
            <select asp-for="productoResponse.IdCategoria" class="form-select" asp-items="Model.categorias" id="categorias">
                <option value="">Seleccione una categoría</option>
            </select>
            <span class="text-danger" asp-validation-for="productoResponse.IdCategoria"></span>
        </div>
        <div class="form-group">
            <label class="control-label" asp-for="productoResponse.Nombre"></label>
            <input class="form-control" asp-for="productoResponse.Nombre" />
            <span class="text-danger" asp-validation-for="productoResponse.Nombre"></span>
        </div>
        <div class="form-group">
            <label class="control-label" asp-for="productoResponse.Descripcion"></label>
            <textarea class="form-control" asp-for="productoResponse.Descripcion"></textarea>
            <span class="text-danger" asp-validation-for="productoResponse.Descripcion"></span>
        </div>
        <div class="form-group">
            <label class="control-label" asp-for="productoResponse.PrecioVentaActual"></label>
            <input class="form-control" asp-for="productoResponse.PrecioVentaActual" />
            <span class="text-danger" asp-validation-for="productoResponse.PrecioVentaActual"></span>
        </div>
        <div class="form-group">
            <label class="control-label" asp-for="productoResponse.Imagen"></label>
            <input class="form-control" asp-for="productoResponse.Imagen" />
            <span class="text-danger" asp-validation-for="productoResponse.Imagen"></span>
        </div>
        <div class="text-danger" asp-validation-summary="All"></div>
        <div class="actions">
            <a class="btn btn-secondary" asp-page="./Index">
                <i class="bi bi-arrow-left" aria-hidden="true"></i>
                Regresar
            </a>
            <button type="submit" class="btn btn-success">
                <i class="bi bi-check-lg" aria-hidden="true"></i>
                Guardar cambios
            </button>
        </div>
        <input type="hidden" asp-for="productoResponse.IdProducto" />
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
